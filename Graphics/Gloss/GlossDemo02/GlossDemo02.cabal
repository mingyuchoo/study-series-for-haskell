cabal-version: 2.2

name:           GlossDemo02
version:        0.1.0.0
description:    Please see the README on GitHub at <https://github.com/mingyuchoo/GlossDemo02#readme>
homepage:       https://github.com/mingyuchoo/GlossDemo02#readme
bug-reports:    https://github.com/mingyuchoo/GlossDemo02/issues
author:         Mingyu Choo
maintainer:     mingyuchoo@gmail.com
copyright:      Mingyu Choo 2025
license:        BSD-3-Clause
license-file:   LICENSE
build-type:     Simple
extra-source-files:
    README.md
    CHANGELOG.md

source-repository head
  type: git
  location: https://github.com/mingyuchoo/GlossDemo02

library
  exposed-modules:
      Lib
  other-modules:
      Paths_GlossDemo02
  autogen-modules:
      Paths_GlossDemo02
  hs-source-dirs:
      src
  ghc-options: -Wall -Wcompat -Widentities -Wincomplete-record-updates -Wincomplete-uni-patterns -Wmissing-export-lists -Wmissing-home-modules -Wpartial-fields -Wredundant-constraints
  build-depends:
      base >=4.7 && <5
    , gloss
  default-language: GHC2024

executable GlossDemo02-exe
  main-is: Main.hs
  other-modules:
      Paths_GlossDemo02
  autogen-modules:
      Paths_GlossDemo02
  hs-source-dirs:
      app
  ghc-options: -Wall -Wcompat -Widentities -Wincomplete-record-updates -Wincomplete-uni-patterns -Wmissing-export-lists -Wmissing-home-modules -Wpartial-fields -Wredundant-constraints -threaded -rtsopts -with-rtsopts=-N
  build-depends:
      GlossDemo02
    , base >=4.7 && <5
    , gloss
  default-language: GHC2024

test-suite GlossDemo02-test
  type: exitcode-stdio-1.0
  main-is: Spec.hs
  other-modules:
      Paths_GlossDemo02
  autogen-modules:
      Paths_GlossDemo02
  hs-source-dirs:
      test
  ghc-options: -Wall -Wcompat -Widentities -Wincomplete-record-updates -Wincomplete-uni-patterns -Wmissing-export-lists -Wmissing-home-modules -Wpartial-fields -Wredundant-constraints -threaded -rtsopts -with-rtsopts=-N
  build-depends:
      GlossDemo02
    , base >=4.7 && <5
    , gloss
  default-language: GHC2024

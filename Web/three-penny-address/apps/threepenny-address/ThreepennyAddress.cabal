source-repository head
  type: git
  location: https://github.com/mingyuchoo/ThreepennyAddress

library address-book-ui
  exposed-modules:
      GUI.Main
  other-modules:
      GUI.AppState
      GUI.Components
      GUI.Shortcuts
      GUI.State
      GUI.View
      Paths_ThreepennyAddress
  autogen-modules:
      Paths_ThreepennyAddress
  hs-source-dirs:
      src
  default-extensions:
      OverloadedStrings
  ghc-options: -Wall
  build-depends:
      address-book-application
    , address-book-domain
    , base >=4.18 && <5
    , stm
    , text
    , threepenny-gui
  default-language: GHC2024

executable ThreepennyAddress-exe
  main-is: Main.hs
  other-modules:
      Paths_ThreepennyAddress
  autogen-modules:
      Paths_ThreepennyAddress
  hs-source-dirs:
      app
  default-extensions:
      OverloadedStrings
  ghc-options: -Wall -threaded -rtsopts -with-rtsopts=-N
  build-depends:
      address-book-json
    , address-book-ui
    , base >=4.18 && <5
    , bytestring
    , threepenny-gui
  default-language: GHC2024

test-suite ThreepennyAddress-test

-- OPTIONS_GHC
:set +m
:set +s
:set +t
:set -Wall

--  PROMPT
:set prompt "\ESC[1;35m\x03BB> \ESC[m"
:set prompt-cont "\ESC[1;35m > \ESC[m"

-- LANGUAGE EXTENSIONS
:set -XExplicitForAll
:set -XStandaloneKindSignatures

-- HLINT
:def! hlint const . return $ ":! hlint packages/*/src packages/*/test apps/*/src apps/*/app apps/*/test"

-- HOOGLE
:def! hoogle \x -> return $ ":! hoogle --count=20 \"" ++ x ++ "\""

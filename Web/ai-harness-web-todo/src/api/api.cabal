cabal-version:      2.4
name:               api
version:            0.1.0.0
synopsis:           Todo 앱의 HTTP 표면
description:        Servant로 타입 수준에 고정한 HTTP API 어댑터입니다.
license:            MIT
author:             Todo Maintainers
maintainer:         maintainers@example.invalid
category:           Web
build-type:         Simple
extra-source-files: README.md

common warnings
    ghc-options: -Wall
                 -Wcompat
                 -Widentities
                 -Wincomplete-record-updates
                 -Wincomplete-uni-patterns
                 -Wpartial-fields
                 -Wredundant-constraints

library
    import:           warnings
    exposed-modules:  Todo.Api.Types
                      Todo.Api.Routes
                      Todo.Api.Server
    hs-source-dirs:   src
    build-depends:    base           >=4.17 && <5
                    , aeson          >=2.1  && <2.3
                    , containers     >=0.6  && <0.9
                    , servant        >=0.20 && <0.21
                    , servant-server >=0.20 && <0.21
                    , sqlite-simple  >=0.4  && <0.5
                    , text           >=2.0  && <2.2
                    , time           >=1.12 && <1.15
                    , core
                    , store
                    , wai            >=3.2  && <3.3
    default-language: Haskell2010

executable api
    import:           warnings
    main-is:          Main.hs
    hs-source-dirs:   app
    ghc-options:      -threaded
    build-depends:    base
                    , api
                    , store
                    , warp           >=3.3  && <3.5
    default-language: Haskell2010

test-suite api-test
    import:           warnings
    type:             exitcode-stdio-1.0
    main-is:          Main.hs
    other-modules:    Todo.Api.ContractSpec
                      Todo.Api.SecuritySpec
                      Todo.Api.Harness
    hs-source-dirs:   tests
    build-depends:    base
                    , aeson
                    , bytestring     >=0.11 && <0.13
                    , filepath       >=1.4  && <1.6
                    , hspec          >=2.10 && <2.12
                    , http-types     >=0.12 && <0.13
                    , temporary      >=1.3  && <1.4
                    , text
                    , api
                    , store
                    , wai
                    , wai-extra      >=3.1  && <3.2
    default-language: Haskell2010

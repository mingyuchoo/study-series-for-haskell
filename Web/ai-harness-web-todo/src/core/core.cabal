cabal-version:      2.4
name:               core
version:            0.1.0.0
synopsis:           Todo 도메인 규칙과 유스케이스
description:        부수 효과가 없는 순수 도메인 계층입니다. 저장과 시간은 포트로 역전합니다.
license:            MIT
author:             Todo Maintainers
maintainer:         maintainers@example.invalid
category:           Application
build-type:         Simple
extra-source-files: README.md

common warnings
    ghc-options: -Wall
                 -Wcompat
                 -Widentities
                 -Wincomplete-record-updates
                 -Wincomplete-uni-patterns
                 -Wpartial-fields
                 -Wredundant-constraints

library
    import:           warnings
    exposed-modules:  Todo.Core.Types
                      Todo.Core.Status
                      Todo.Core.Validation
                      Todo.Core.Filter
                      Todo.Core.Repository
                      Todo.Core.UseCase
    hs-source-dirs:   src
    build-depends:    base        >=4.17 && <5
                    , containers  >=0.6  && <0.9
                    , text        >=2.0  && <2.2
                    , time        >=1.12 && <1.15
    default-language: Haskell2010

test-suite core-test
    import:           warnings
    type:             exitcode-stdio-1.0
    main-is:          Main.hs
    other-modules:    Todo.Core.Gen
                      Todo.Core.StatusSpec
                      Todo.Core.ValidationSpec
                      Todo.Core.FilterSpec
                      Todo.Core.UseCaseSpec
    hs-source-dirs:   tests
    build-depends:    base
                    , QuickCheck  >=2.14 && <2.17
                    , containers
                    , hspec       >=2.10 && <2.12
                    , mtl         >=2.2  && <2.4
                    , text
                    , time
                    , core
    default-language: Haskell2010

cabal-version:      2.4
name:               store
version:            0.1.0.0
synopsis:           Todo 저장 포트의 SQLite 어댑터
description:        core가 정의한 TodoRepository 포트를 SQLite로 구현합니다.
license:            MIT
author:             Todo Maintainers
maintainer:         maintainers@example.invalid
category:           Database
build-type:         Simple
extra-source-files: README.md
                    schema/schema.sql

common warnings
    ghc-options: -Wall
                 -Wcompat
                 -Widentities
                 -Wincomplete-record-updates
                 -Wincomplete-uni-patterns
                 -Wpartial-fields
                 -Wredundant-constraints

library
    import:           warnings
    exposed-modules:  Todo.Store.Migration
                      Todo.Store.Sqlite
    hs-source-dirs:   src
    build-depends:    base          >=4.17 && <5
                    , containers    >=0.6  && <0.9
                    , file-embed    >=0.0.15 && <0.1
                    , mtl           >=2.2  && <2.4
                    , sqlite-simple >=0.4  && <0.5
                    , text          >=2.0  && <2.2
                    , time          >=1.12 && <1.15
                    , core
    default-language: Haskell2010

test-suite store-test
    import:           warnings
    type:             exitcode-stdio-1.0
    main-is:          Main.hs
    other-modules:    Todo.Store.SqliteSpec
                      Todo.Store.RegressionSpec
    hs-source-dirs:   tests
    ghc-options:      -threaded
    build-depends:    base
                    , containers
                    , filepath      >=1.4  && <1.6
                    , hspec         >=2.10 && <2.12
                    , sqlite-simple
                    , temporary     >=1.3  && <1.4
                    , text
                    , time
                    , core
                    , store
    default-language: Haskell2010

{
  "name": "warp-user-management",
  "private": true,
  "workspaces": ["apps/frontend"],
  "scripts": {
    "build": "npm run build --workspace @warp/frontend",
    "test": "npm run test --workspace @warp/frontend",
    "test:e2e": "npm run build && playwright test",
    "test:integration": "npm run build && stack build && node --test tests/integration/warp.test.mjs",
    "format:check": "elm-format apps/frontend/src apps/frontend/tests --validate"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "elm": "0.19.3-0",
    "elm-format": "0.8.8",
    "elm-test": "0.19.3-0"
  }
}

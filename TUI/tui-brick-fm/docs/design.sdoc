  VALUE: HFM-REQ-REFRESH
- TYPE: Parent
  VALUE: HFM-REQ-OPERATION-RESULT
- TYPE: File
  VALUE: packages/hfm-application/src/Hfm/Application/Internal/PanelRefresh.hs
- TYPE: File

-- OPTIONS_GHC
:set +m
:set +s
:set +t
:set -Wall

--  PROMPT
:set prompt "\ESC[1;35m\x03BB> \ESC[m"
:set prompt-cont "\ESC[1;35m > \ESC[m"

-- INCLUDE DIRECTORIES
:set -ipackages/hfm-domain/src
:set -ipackages/hfm-application/src
:set -ipackages/hfm-infrastructure/src
:set -ipackages/hfm-tui/src
:set -iapps/hfm/app

-- LANGUAGE EXTENSIONS
:set -XExplicitForAll
:set -XStandaloneKindSignatures

-- HLINT
:def hlint const . return $ ":! hlint packages apps"

-- HOOGLE
:def hoogle \x -> return $ ":! hoogle --count=20 \"" ++ x ++ "\""

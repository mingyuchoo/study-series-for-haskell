      Hfm.Application.Program
      Hfm.Application.Startup
      Hfm.Application.Status
      Hfm.Application.Workflow
      Hfm.Application.Ports
      Hfm.Application.State
      Hfm.Application.UseCases
  other-modules:
      Hfm.Application.Internal.Action
      Hfm.Application.Internal.Files
      Hfm.Application.Internal.Interaction
  hs-source-dirs:
      src
  default-extensions:
      OverloadedStrings
  ghc-options: -Wall -O2
